---
// src/pages/catalog/[...category].astro
import MainLayout from "../../layouts/MainLayout.astro";
import ProductCard from "../../components/ProductCard.astro";
import { CATEGORIES } from "../../data/products";
import { getCollection, type CollectionEntry } from "astro:content";

export async function getStaticPaths() {
  return [
    { params: { category: undefined } }, // Para /catalog
    { params: { category: "todas" } }, // Alias opcional
    { params: { category: "aretes" } },
    { params: { category: "collares" } },
    { params: { category: "anillos" } },
    { params: { category: "pulseras" } },
  ];
}

const { category } = Astro.params;
const categoryParam = category && category !== "todas" ? category : "todas";

// Obtener los productos de la colección
const allProducts = await getCollection("productos");

// Filter products based on the category
const filteredProducts =
  categoryParam === "todas"
    ? allProducts
    : allProducts.filter(
        (p: CollectionEntry<"productos">) => p.data.category === categoryParam
      );

const currentCategoryName =
  CATEGORIES.find((c) => c.id === categoryParam)?.name || "Catálogo";
---

<MainLayout title={`Catálogo | ${currentCategoryName}`}>
  <div class="catalog-page">
    <header class="catalog-header" transition:animate="fade">
      <div class="container">
        <h1 class="main-title">{currentCategoryName}</h1>
        <span class="subtitle">EXPLORA NUESTRAS JOYAS</span>
        <p class="description">
          Piezas únicas diseñadas para resaltar tu belleza natural.
        </p>
      </div>
    </header>

    <div class="container">
      <!-- Filter Bar -->
      <div class="filter-bar-container" transition:name="filter-bar">
        <nav class="filter-bar">
          <div class="scroll-spacer-start"></div>
          {
            CATEGORIES.map((cat) => (
              <a
                href={cat.id === "todas" ? "/catalog" : `/catalog/${cat.id}`}
                class={`filter-btn ${categoryParam === cat.id ? "active" : ""}`}
              >
                {cat.name}
              </a>
            ))
          }
          <div class="scroll-spacer-end"></div>
        </nav>
      </div>

      <!-- Products Grid -->
      <div class="products-grid" transition:animate="slide">
        {
          filteredProducts.length > 0 ? (
            filteredProducts.map(
              (product, index) => (
                <ProductCard
                  product={product.data}
                  slug={product.id}
                  eager={index < 4}
                />
              )
            )
          ) : (
            <div class="no-products">
              <p>Próximamente tendremos más piezas en esta categoría.</p>
              <a href="/catalog" class="back-btn">
                Ver todo el catálogo
              </a>
            </div>
          )
        }
      </div>
    </div>
  </div>
</MainLayout>

<style>
  .catalog-page {
    background-color: var(--brand-ivory);
    min-height: 100vh;
    font-family: "Outfit", sans-serif;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .catalog-header {
    text-align: center;
    padding-top: 140px; /* Espacio para el navbar absoluto flotante */
    padding-bottom: 60px;
    background: linear-gradient(
      to bottom,
      var(--brand-ivory),
      rgba(252, 249, 242, 0.4)
    );
  }

  .subtitle {
    display: block;
    font-size: 12px;
    letter-spacing: 3px;
    color: var(--brand-vermillion);
    margin-bottom: 10px;
    font-weight: 600;
  }

  .main-title {
    font-family: "Cormorant Garamond", serif;
    font-size: 3.5rem;
    color: #2d2d2d;
    margin-bottom: 15px;
  }

  .description {
    color: #8c8c8c;
    max-width: 600px;
    margin: 0 auto;
    font-size: 1.1rem;
  }

  /* Filter Bar */
  .filter-bar-container {
    position: sticky;
    top: 20px;
    z-index: 40;
    margin-bottom: 50px;
    display: flex;
    justify-content: center;
    padding: 0 10px; /* Slight padding for mobile */
  }

  .filter-bar {
    display: flex;
    gap: 8px;
    background: #ffffff;
    padding: 8px;
    border-radius: 50px;
    box-shadow: 0 15px 35px -5px rgba(0, 0, 0, 0.05),
      0 5px 15px -5px rgba(232, 75, 16, 0.05);
    border: 1px solid rgba(232, 75, 16, 0.1);
    max-width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none; /* Firefox */
  }

  .filter-bar::-webkit-scrollbar {
    display: none; /* Chrome, Safari and Opera */
  }

  .filter-btn {
    text-decoration: none;
    color: #666;
    font-size: 14px;
    font-weight: 500;
    padding: 10px 24px;
    border-radius: 30px;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    background: transparent;
    white-space: nowrap;
  }

  .filter-btn:hover {
    color: var(--brand-vermillion);
    background: rgba(232, 75, 16, 0.04);
  }

  .filter-btn.active {
    background: var(--brand-vermillion);
    color: white;
    box-shadow: 0 8px 20px rgba(232, 75, 16, 0.25);
  }

  /* Spacers for smooth mobile scrolling boundary */
  .scroll-spacer-start,
  .scroll-spacer-end {
    display: none;
  }

  /* Grid */
  .products-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 30px;
    padding-bottom: 100px;
  }

  .no-products {
    grid-column: 1 / -1;
    text-align: center;
    padding: 100px 0;
    color: #8c8c8c;
  }

  .back-btn {
    display: inline-block;
    margin-top: 20px;
    color: var(--brand-vermillion);
    text-decoration: none;
    font-weight: 600;
    border-bottom: 2px solid var(--brand-vermillion);
  }

  @media (max-width: 768px) {
    .main-title {
      font-size: 2.5rem;
    }

    .filter-bar-container {
      top: 15px;
      justify-content: flex-start;
      padding: 0;
      margin-left: -10px;
      margin-right: -10px;
    }

    .filter-bar {
      padding: 8px 12px;
      gap: 6px;
      border-radius: 25px; /* Balanced pill style on mobile */

      /* Premium fading mask at the scroll boundaries */
      mask-image: linear-gradient(
        to right,
        transparent,
        black 16px,
        black calc(100% - 16px),
        transparent
      );
      -webkit-mask-image: linear-gradient(
        to right,
        transparent,
        black 16px,
        black calc(100% - 16px),
        transparent
      );
    }

    .filter-btn {
      padding: 8px 18px; /* Tighter padding for comfortable layout */
      font-size: 13px; /* Optimized font size for mobile screens */
    }

    .scroll-spacer-start {
      display: block;
      min-width: 8px;
      height: 1px;
      flex-shrink: 0;
    }

    .scroll-spacer-end {
      display: block;
      min-width: 16px;
      height: 1px;
      flex-shrink: 0;
    }
  }
</style>

<script>
  function scrollActiveBtnIntoView() {
    const activeBtn = document.querySelector(".filter-btn.active");
    if (activeBtn) {
      activeBtn.scrollIntoView({
        behavior: "auto",
        block: "nearest",
        inline: "center",
      });
    }
  }

  // Auto-scroll active category into view on page load
  scrollActiveBtnIntoView();

  // Re-run after Astro View Transitions swap content
  document.addEventListener("astro:after-swap", scrollActiveBtnIntoView);
</script>
