---
import MainLayout from "../layouts/MainLayout.astro";


const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/productos/*.{jpeg,jpg,png}",
  { eager: true }
);

function getImageUrl(filename: string) {
  const match = Object.keys(images).find((key) => {
    const parts = key.split("/");
    return parts[parts.length - 1] === filename;
  });
  return match ? images[match].default.src : "";
}

const categoryBases = {
  anillos: [getImageUrl("anillo1.jpg"), getImageUrl("anillo2.jpg")],
  pulseras: [
    getImageUrl("pulsera1.jpg"),
    getImageUrl("pulsera2.jpg"),
    getImageUrl("pulsera3.jpg"),
  ],
  collares: [
    getImageUrl("collar1.jpg"),
    getImageUrl("collar2.jpg"),
    getImageUrl("collar3.jpg"),
  ],
  aretes: [
    getImageUrl("aretes1.jpg"),
    getImageUrl("aretes2.jpg"),
    getImageUrl("aretes3.jpg"),
  ],
};

const dijes = [
  { url: getImageUrl("dije_corazon_oro.jpg"), name: "Corazón de Oro" },
  { url: getImageUrl("dije_estrella_plata.jpg"), name: "Estrella de Plata" },
  { url: getImageUrl("dije_mariposa_oro.jpg"), name: "Mariposa de Oro" },
];
---

<MainLayout title="Personalización | Veranieras">
  <main class="custom-page">
    <header class="custom-header">
      <div class="header-star">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
          ><path
            d="M12 2L13.5 10.5L22 12L13.5 13.5L12 22L10.5 13.5L2 12L10.5 10.5L12 2Z"
            fill="currentColor"></path>
        </svg>
      </div>
      <span class="header-overline">EXPERIENCIA EXCLUSIVA</span>
      <h1 class="header-title">Crea tu pieza <em>única</em></h1>
      <p class="header-desc">
        Sigue los pasos y diseña una joya que refleje tu esencia y estilo
        personal.
      </p>
    </header>


    <section class="customizer-section">
      <div
        class="customizer"
        id="customizer-container"
        data-bases={JSON.stringify(categoryBases)}
        data-dijes={JSON.stringify(dijes)}
      >

        <div class="customizer__controls">
          <div class="progress-track">
            <div class="progress-line">
              <div class="progress-fill" id="progress-fill"></div>
            </div>
            <div class="step-dot is-active" data-step="1">
              <div class="dot-circle"><span>1</span></div>
              <span class="dot-label">Categoría</span>
            </div>
            <div class="step-dot" data-step="2">
              <div class="dot-circle"><span>2</span></div>
              <span class="dot-label">Base</span>
            </div>
            <div class="step-dot" data-step="3">
              <div class="dot-circle"><span>3</span></div>
              <span class="dot-label">Dije</span>
            </div>
          </div>


          <div class="steps-container">
            <div id="step-1" class="step-panel is-visible">
              <h2 class="step-title">¿Qué joya deseas personalizar?</h2>
              <div class="cat-grid">
                <button class="cat-card" data-cat="anillos">
                  <div class="cat-icon">
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      ><circle cx="12" cy="14" r="7"></circle><path
                        d="M8.5 7.5C9.5 5 10.5 4 12 4s2.5 1 3.5 3.5"></path>
                    </svg>
                  </div>
                  <span class="cat-name">Anillos</span>
                </button>
                <button class="cat-card" data-cat="pulseras">
                  <div class="cat-icon">
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      ><ellipse cx="12" cy="12" rx="9" ry="6"></ellipse><path
                        d="M12 6v12"></path>
                    </svg>
                  </div>
                  <span class="cat-name">Pulseras</span>
                </button>
                <button class="cat-card" data-cat="collares">
                  <div class="cat-icon">
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      ><path d="M6 3C6 3 5 8 5 12s2 7 7 7 7-3 7-7 -1-9-1-9"
                      ></path><circle cx="12" cy="19" r="2"></circle>
                    </svg>
                  </div>
                  <span class="cat-name">Collares</span>
                </button>
                <button class="cat-card" data-cat="aretes">
                  <div class="cat-icon">
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      ><path d="M12 2v4"></path><circle cx="12" cy="10" r="4"
                      ></circle><path d="M12 14v2"></path><circle
                        cx="12"
                        cy="19"
                        r="3"></circle>
                    </svg>
                  </div>
                  <span class="cat-name">Aretes</span>
                </button>
              </div>
            </div>

            <div id="step-2" class="step-panel">
              <div class="step-top-row">
                <button id="back-to-1" class="back-btn">
                  <svg
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    ><path d="m15 18-6-6 6-6"></path>
                  </svg>
                  Volver
                </button>
                <h2 class="step-title">Elige la base</h2>
              </div>
              <div class="bases-row" id="bases-carousel">

              </div>
            </div>


            <div id="step-3" class="step-panel">
              <div class="step-top-row">
                <button id="back-to-2" class="back-btn">
                  <svg
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    ><path d="m15 18-6-6 6-6"></path>
                  </svg>
                  Volver
                </button>
                <h2 class="step-title">Añade un dije</h2>
              </div>
              <div class="charms-grid" id="charms-grid">
              </div>
              <button id="finish-btn" class="cta-btn" disabled>
                <span>Ver Resultado Final</span>
                <svg
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  ><path d="M5 12h14M13 18l6-6-6-6"></path>
                </svg>
              </button>
            </div>

            <div id="step-result" class="step-panel">
              <div class="result-content">
                <div class="result-check">
                  <svg
                    width="32"
                    height="32"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    ><polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                </div>
                <h2 class="result-title">¡Tu diseño está listo!</h2>
                <p class="result-desc">
                  Has creado una pieza única que refleja tu estilo. Contáctanos
                  para hacerla realidad.
                </p>
                <div class="result-actions">
                  <button id="reset-btn" class="outline-btn">Crear otra</button>
                  <a
                    href="https://wa.me/573127894556?text=Hola%20Veranieras!%20Acabo%20de%20diseñar%20una%20pieza%20personalizada%20y%20me%20gustaría%20cotizarla."
                    target="_blank"
                    rel="noopener noreferrer"
                    class="cta-btn wa-btn"
                  >
                    <svg
                      width="18"
                      height="18"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      ><path
                        d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"
                      ></path>
                    </svg>
                    <span>Cotizar por WhatsApp</span>
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>


        <div class="customizer__preview">
          <div class="preview-canvas" id="preview-area">
            <div class="corner corner--tl"></div>
            <div class="corner corner--tr"></div>
            <div class="corner corner--bl"></div>
            <div class="corner corner--br"></div>

            <div id="empty-state" class="preview-empty">
              <svg
                width="48"
                height="48"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path
                  d="M12 2L13.5 10.5L22 12L13.5 13.5L12 22L10.5 13.5L2 12L10.5 10.5L12 2Z"
                ></path>
              </svg>
              <p>Tu diseño aparecerá aquí</p>
            </div>

            <img
              id="preview-base"
              src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7"
              alt="Base seleccionada"
              class="preview-base-img"
            />

            <div id="preview-charm-container" class="preview-charm-wrap">
              <img
                id="preview-charm"
                src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7"
                alt="Dije seleccionado"
                class="preview-charm-img"
              />
            </div>

            <div class="pedestal-shadow"></div>
          </div>
        </div>
      </div>
    </section>
  </main>
</MainLayout>

<script>
  import { initPersonalizer } from "../scripts/personalize.js";

  document.addEventListener('astro:page-load', () => {
    initPersonalizer();
  });

</script>

<style>
  .custom-page {
    --ease-out: cubic-bezier(0.23, 1, 0.32, 1);
    --ease-in-out: cubic-bezier(0.77, 0, 0.175, 1);
    --dur-fast: 160ms;
    --dur-normal: 250ms;
    --dur-slow: 400ms;

    background: var(--brand-ivory);
    min-height: 100vh;
    font-family: "Outfit", sans-serif;
    padding-top: 120px;
    padding-bottom: 80px;
  }

  .custom-header {
    text-align: center;
    max-width: 580px;
    margin: 0 auto 56px;
    padding: 0 24px;
  }

  .header-star {
    color: var(--brand-gold);
    margin-bottom: 12px;
    display: flex;
    justify-content: center;
  }

  .header-overline {
    display: block;
    font-size: 11px;
    letter-spacing: 3.5px;
    color: var(--brand-vermillion);
    font-weight: 600;
    margin-bottom: 12px;
  }

  .header-title {
    font-family: "Cormorant Garamond", serif;
    font-size: clamp(2.2rem, 5vw, 3.4rem);
    color: var(--brand-wine);
    line-height: 1.15;
    margin-bottom: 14px;
  }

  .header-title em {
    font-style: italic;
    color: var(--brand-vermillion);
  }

  .header-desc {
    font-size: 1.05rem;
    color: #8c7a6b;
    line-height: 1.6;
    max-width: 440px;
    margin: 0 auto;
  }

  .customizer-section {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .customizer {
    display: grid;
    grid-template-columns: 1fr 1fr;
    background: #ffffff;
    border-radius: 28px;
    overflow: hidden;
    box-shadow: 0 30px 80px -16px rgba(92, 26, 42, 0.08),
      0 8px 24px -8px rgba(0, 0, 0, 0.03);
    border: 1px solid rgba(232, 75, 16, 0.06);
  }

  .customizer__controls {
    padding: 44px 48px;
    background: linear-gradient(145deg, #fdfbf7 0%, #f7f2ea 100%);
    display: flex;
    flex-direction: column;
    border-right: 1px solid rgba(232, 75, 16, 0.06);
  }

  .customizer__preview {
    padding: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(155deg, #ffffff 0%, #fdf5ec 50%, #f7e7e0 100%);
    position: relative;
  }

  .progress-track {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    position: relative;
    margin-bottom: 40px;
    padding: 0 8px;
  }

  .progress-line {
    position: absolute;
    top: 18px;
    left: 36px;
    right: 36px;
    height: 2px;
    background: #e8dccb;
    border-radius: 2px;
    z-index: 0;
  }

  .progress-fill {
    height: 100%;
    width: 0%;
    background: var(--brand-vermillion);
    border-radius: 2px;
    transition: width var(--dur-slow) var(--ease-out);
  }

  .step-dot {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    position: relative;
    z-index: 1;
  }

  .dot-circle {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: #e8dccb;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all var(--dur-normal) var(--ease-out);
  }

  .dot-circle span {
    font-size: 13px;
    font-weight: 700;
    color: #8c7a6b;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color var(--dur-normal) var(--ease-out);
  }

  .dot-label {
    font-size: 10px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: #8c7a6b;
    transition: color var(--dur-normal) var(--ease-out);
  }

  .step-dot.is-active .dot-circle {
    background: var(--brand-vermillion);
    box-shadow: 0 4px 16px rgba(232, 75, 16, 0.3);
    transform: scale(1.1);
  }

  .step-dot.is-active .dot-circle span {
    color: #ffffff;
  }

  .step-dot.is-active .dot-label {
    color: var(--brand-vermillion);
  }

  .step-dot.is-done .dot-circle {
    background: var(--brand-gold);
    box-shadow: 0 3px 12px rgba(245, 192, 32, 0.25);
  }

  .step-dot.is-done .dot-circle span {
    color: #ffffff;
  }

  .step-dot.is-done .dot-label {
    color: var(--brand-gold);
  }

  .steps-container {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 320px;
  }

  .step-panel {
    opacity: 0;
    transform: translateY(10px);
    pointer-events: none;
    position: absolute;
    inset: 0;
    transition: opacity var(--dur-normal) var(--ease-out),
      transform var(--dur-normal) var(--ease-out);
    display: flex;
    flex-direction: column;
  }

  .step-panel.is-visible {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
    position: relative;
  }

  .step-title {
    font-family: "Cormorant Garamond", serif;
    font-size: 1.65rem;
    color: var(--brand-wine);
    margin-bottom: 24px;
    line-height: 1.25;
  }

  .step-top-row {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 24px;
  }

  .step-top-row .step-title {
    margin-bottom: 0;
  }

  .back-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    font-weight: 500;
    color: #8c7a6b;
    background: none;
    border: none;
    cursor: pointer;
    padding: 6px 12px;
    border-radius: 8px;
    transition: all var(--dur-fast) var(--ease-out);
    flex-shrink: 0;
  }

  .back-btn:hover {
    color: var(--brand-wine);
    background: rgba(232, 75, 16, 0.04);
  }

  .back-btn:active {
    transform: scale(0.97);
  }

  .cat-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14px;
  }

  .cat-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 28px 16px;
    background: #ffffff;
    border: 1px solid #e8dccb;
    border-radius: 18px;
    cursor: pointer;
    transition: transform var(--dur-fast) var(--ease-out),
      box-shadow var(--dur-normal) var(--ease-out),
      border-color var(--dur-normal) var(--ease-out);
    animation: staggerFadeIn var(--dur-slow) var(--ease-out) both;
  }

  .cat-card:nth-child(1) {
    animation-delay: 0ms;
  }
  .cat-card:nth-child(2) {
    animation-delay: 60ms;
  }
  .cat-card:nth-child(3) {
    animation-delay: 120ms;
  }
  .cat-card:nth-child(4) {
    animation-delay: 180ms;
  }

  @media (hover: hover) and (pointer: fine) {
    .cat-card:hover {
      border-color: rgba(232, 75, 16, 0.25);
      box-shadow: 0 12px 32px -8px rgba(232, 75, 16, 0.12),
        0 4px 12px -4px rgba(0, 0, 0, 0.04);
      transform: translateY(-3px);
    }
  }

  .cat-card:active {
    transform: scale(0.97);
  }

  .cat-icon {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: linear-gradient(135deg, #fdf5ec, #f5e6d3);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--brand-wine);
    transition: transform var(--dur-normal) var(--ease-out);
  }

  .cat-icon svg {
    width: 24px;
    height: 24px;
  }

  @media (hover: hover) and (pointer: fine) {
    .cat-card:hover .cat-icon {
      transform: scale(1.08);
    }
  }

  .cat-name {
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.5px;
    color: var(--brand-text);
  }

  .bases-row {
    display: flex;
    gap: 14px;
    overflow-x: auto;
    padding-bottom: 12px;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
    scrollbar-color: #d4c3b3 transparent;
  }

  .bases-row::-webkit-scrollbar {
    height: 5px;
  }
  .bases-row::-webkit-scrollbar-track {
    background: transparent;
  }
  .bases-row::-webkit-scrollbar-thumb {
    background: #d4c3b3;
    border-radius: 10px;
  }

  .base-card {
    flex: 0 0 170px;
    background: #ffffff;
    border: 1px solid #e8dccb;
    border-radius: 16px;
    padding: 12px;
    cursor: pointer;
    scroll-snap-align: center;
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    transition: transform var(--dur-fast) var(--ease-out),
      border-color var(--dur-normal) var(--ease-out),
      box-shadow var(--dur-normal) var(--ease-out);
    animation: staggerFadeIn var(--dur-slow) var(--ease-out) both;
  }

  .base-card img {
    width: 100%;
    height: 120px;
    object-fit: cover;
    border-radius: 10px;
  }

  .base-label {
    font-size: 12px;
    font-weight: 500;
    color: var(--brand-text);
  }

  .base-ring {
    position: absolute;
    inset: -1px;
    border-radius: 16px;
    border: 2.5px solid transparent;
    pointer-events: none;
    transition: border-color var(--dur-normal) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .base-card:hover {
      border-color: rgba(232, 75, 16, 0.2);
      box-shadow: 0 8px 24px -6px rgba(232, 75, 16, 0.1);
      transform: translateY(-2px);
    }
  }

  .base-card:active {
    transform: scale(0.97);
  }

  .base-card.is-selected {
    border-color: var(--brand-vermillion);
    box-shadow: 0 0 0 3px rgba(232, 75, 16, 0.1),
      0 8px 24px -6px rgba(232, 75, 16, 0.15);
  }

  .base-card.is-selected .base-ring {
    border-color: var(--brand-vermillion);
  }

  .charms-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    margin-bottom: 24px;
  }

  .charm-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    padding: 16px 10px;
    background: #ffffff;
    border: 1px solid #e8dccb;
    border-radius: 14px;
    cursor: pointer;
    transition: transform var(--dur-fast) var(--ease-out),
      border-color var(--dur-normal) var(--ease-out),
      box-shadow var(--dur-normal) var(--ease-out);
    animation: staggerFadeIn var(--dur-slow) var(--ease-out) both;
  }

  .charm-img-wrap {
    width: 56px;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .charm-img-wrap img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.08));
  }

  .charm-name {
    font-size: 11px;
    font-weight: 500;
    color: var(--brand-text);
    text-align: center;
    line-height: 1.3;
  }

  @media (hover: hover) and (pointer: fine) {
    .charm-card:hover {
      border-color: rgba(232, 75, 16, 0.2);
      box-shadow: 0 6px 20px -6px rgba(232, 75, 16, 0.1);
      transform: translateY(-2px);
    }
  }

  .charm-card:active {
    transform: scale(0.97);
  }

  .charm-card.is-selected {
    border-color: var(--brand-vermillion);
    background: rgba(232, 75, 16, 0.03);
    box-shadow: 0 0 0 3px rgba(232, 75, 16, 0.08);
  }

  .cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    padding: 16px 24px;
    background: var(--brand-vermillion);
    color: #ffffff;
