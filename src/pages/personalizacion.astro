---
import MainLayout from "../layouts/MainLayout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

// Get all images statically so Astro/Vite bundles them
const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/productos/*.{jpeg,jpg,png}",
  { eager: true }
);

function getImageUrl(filename: string) {
  const match = Object.keys(images).find((key) => key.includes(filename));
  return match ? images[match].default.src : "";
}

const categoryBases = {
  anillos: [getImageUrl("anillo1.jpg"), getImageUrl("anillo2.jpg")],
  pulseras: [
    getImageUrl("pulsera1.jpg"),
    getImageUrl("pulsera2.jpg"),
    getImageUrl("pulsera3.jpg"),
  ],
  collares: [
    getImageUrl("collar1.jpg"),
    getImageUrl("collar2.jpg"),
    getImageUrl("collar3.jpg"),
  ],
  aretes: [
    getImageUrl("aretes1.jpg"),
    getImageUrl("aretes2.jpg"),
    getImageUrl("aretes3.jpg"),
  ],
};

const dijes = [
  { url: getImageUrl("dije_corazon_oro"), name: "Corazón de Oro" },
  { url: getImageUrl("dije_estrella_plata"), name: "Estrella de Plata" },
  { url: getImageUrl("dije_mariposa_oro"), name: "Mariposa de Oro" },
];
---

<MainLayout title="Personalización | Veranieras">
  <main class="custom-page">
    <!-- Page Header -->
    <header class="custom-header">
      <div class="header-star">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
          ><path
            d="M12 2L13.5 10.5L22 12L13.5 13.5L12 22L10.5 13.5L2 12L10.5 10.5L12 2Z"
            fill="currentColor"></path>
        </svg>
      </div>
      <span class="header-overline">EXPERIENCIA EXCLUSIVA</span>
      <h1 class="header-title">Crea tu Pieza <em>Única</em></h1>
      <p class="header-desc">
        Sigue los pasos y diseña una joya que refleje tu esencia y estilo
        personal.
      </p>
    </header>

    <!-- Customizer -->
    <section class="customizer-section">
      <div
        class="customizer"
        id="customizer-container"
        data-bases={JSON.stringify(categoryBases)}
        data-dijes={JSON.stringify(dijes)}
      >
        <!-- Left: Controls -->
        <div class="customizer__controls">
          <!-- Step Progress -->
          <div class="progress-track">
            <div class="progress-line">
              <div class="progress-fill" id="progress-fill"></div>
            </div>
            <div class="step-dot is-active" data-step="1">
              <div class="dot-circle"><span>1</span></div>
              <span class="dot-label">Categoría</span>
            </div>
            <div class="step-dot" data-step="2">
              <div class="dot-circle"><span>2</span></div>
              <span class="dot-label">Base</span>
            </div>
            <div class="step-dot" data-step="3">
              <div class="dot-circle"><span>3</span></div>
              <span class="dot-label">Dije</span>
            </div>
          </div>

          <!-- Step Panels -->
          <div class="steps-container">
            <!-- Step 1: Category -->
            <div id="step-1" class="step-panel is-visible">
              <h2 class="step-title">¿Qué joya deseas personalizar?</h2>
              <div class="cat-grid">
                <button class="cat-card" data-cat="anillos">
                  <div class="cat-icon">
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      ><circle cx="12" cy="14" r="7"></circle><path
                        d="M8.5 7.5C9.5 5 10.5 4 12 4s2.5 1 3.5 3.5"></path>
                    </svg>
                  </div>
                  <span class="cat-name">Anillos</span>
                </button>
                <button class="cat-card" data-cat="pulseras">
                  <div class="cat-icon">
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      ><ellipse cx="12" cy="12" rx="9" ry="6"></ellipse><path
                        d="M12 6v12"></path>
                    </svg>
                  </div>
                  <span class="cat-name">Pulseras</span>
                </button>
                <button class="cat-card" data-cat="collares">
                  <div class="cat-icon">
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      ><path d="M6 3C6 3 5 8 5 12s2 7 7 7 7-3 7-7 -1-9-1-9"
                      ></path><circle cx="12" cy="19" r="2"></circle>
                    </svg>
                  </div>
                  <span class="cat-name">Collares</span>
                </button>
                <button class="cat-card" data-cat="aretes">
                  <div class="cat-icon">
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      ><path d="M12 2v4"></path><circle cx="12" cy="10" r="4"
                      ></circle><path d="M12 14v2"></path><circle
                        cx="12"
                        cy="19"
                        r="3"></circle>
                    </svg>
                  </div>
                  <span class="cat-name">Aretes</span>
                </button>
              </div>
            </div>

            <!-- Step 2: Base Selection -->
            <div id="step-2" class="step-panel">
              <div class="step-top-row">
                <button id="back-to-1" class="back-btn">
                  <svg
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    ><path d="m15 18-6-6 6-6"></path>
                  </svg>
                  Volver
                </button>
                <h2 class="step-title">Elige la base</h2>
              </div>
              <div class="bases-row" id="bases-carousel">
                <!-- Populated by JS -->
              </div>
            </div>

            <!-- Step 3: Charm Selection -->
            <div id="step-3" class="step-panel">
              <div class="step-top-row">
                <button id="back-to-2" class="back-btn">
                  <svg
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    ><path d="m15 18-6-6 6-6"></path>
                  </svg>
                  Volver
                </button>
                <h2 class="step-title">Añade un dije</h2>
              </div>
              <div class="charms-grid" id="charms-grid">
                <!-- Populated by JS -->
              </div>
              <button id="finish-btn" class="cta-btn" disabled>
                <span>Ver Resultado Final</span>
                <svg
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  ><path d="M5 12h14M13 18l6-6-6-6"></path>
                </svg>
              </button>
            </div>

            <!-- Result -->
            <div id="step-result" class="step-panel">
              <div class="result-content">
                <div class="result-check">
                  <svg
                    width="32"
                    height="32"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    ><polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                </div>
                <h2 class="result-title">¡Tu diseño está listo!</h2>
                <p class="result-desc">
                  Has creado una pieza única que refleja tu estilo. Contáctanos
                  para hacerla realidad.
                </p>
                <div class="result-actions">
                  <button id="reset-btn" class="outline-btn">Crear otra</button>
                  <a
                    href="https://wa.me/573127894556?text=Hola%20Veranieras!%20Acabo%20de%20diseñar%20una%20pieza%20personalizada%20y%20me%20gustaría%20cotizarla."
                    target="_blank"
                    rel="noopener noreferrer"
                    class="cta-btn wa-btn"
                  >
                    <svg
                      width="18"
                      height="18"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      ><path
                        d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"
                      ></path>
                    </svg>
                    <span>Cotizar por WhatsApp</span>
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Right: Preview -->
        <div class="customizer__preview">
          <div class="preview-canvas" id="preview-area">
            <!-- Decorative corners -->
            <div class="corner corner--tl"></div>
            <div class="corner corner--tr"></div>
            <div class="corner corner--bl"></div>
            <div class="corner corner--br"></div>

            <!-- Empty State -->
            <div id="empty-state" class="preview-empty">
              <svg
                width="48"
                height="48"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path
                  d="M12 2L13.5 10.5L22 12L13.5 13.5L12 22L10.5 13.5L2 12L10.5 10.5L12 2Z"
                ></path>
              </svg>
              <p>Tu diseño aparecerá aquí</p>
            </div>

            <!-- Base image -->
            <img
              id="preview-base"
              src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7"
              alt="Base seleccionada"
              class="preview-base-img"
            />

            <!-- Charm overlay -->
            <div id="preview-charm-container" class="preview-charm-wrap">
              <img
                id="preview-charm"
                src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7"
                alt="Dije seleccionado"
                class="preview-charm-img"
              />
            </div>

            <!-- Pedestal shadow -->
            <div class="pedestal-shadow"></div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</MainLayout>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const container = document.getElementById("customizer-container");
    if (!container) return;

    const categoryBases: Record<string, string[]> = JSON.parse(
      container.dataset.bases || "{}"
    );
    const dijes: Array<{ url: string; name: string }> = JSON.parse(
      container.dataset.dijes || "[]"
    );

    // State
    let state: {
      step: number;
      category: string | null;
      base: string | null;
      charm: { url: string; name: string } | null;
    } = { step: 1, category: null, base: null, charm: null };

    // Safe DOM queries — bail out entirely if any critical element is missing
    const stepEls = [
      document.getElementById("step-1"),
      document.getElementById("step-2"),
      document.getElementById("step-3"),
      document.getElementById("step-result"),
    ];
    const progressFill = document.getElementById("progress-fill");
    const basesCarousel = document.getElementById("bases-carousel");
    const charmsGrid = document.getElementById("charms-grid");
    const emptyState = document.getElementById("empty-state");
    const previewBase = document.getElementById(
      "preview-base"
    ) as HTMLImageElement | null;
    const previewCharmContainer = document.getElementById(
      "preview-charm-container"
    );
    const previewCharm = document.getElementById(
      "preview-charm"
    ) as HTMLImageElement | null;
    const finishBtn = document.getElementById(
      "finish-btn"
    ) as HTMLButtonElement | null;
    const backTo1 = document.getElementById("back-to-1");
    const backTo2 = document.getElementById("back-to-2");
    const resetBtn = document.getElementById("reset-btn");

    // Guard: every critical element must exist
    if (
      !progressFill ||
      !basesCarousel ||
      !charmsGrid ||
      !emptyState ||
      !previewBase ||
      !previewCharmContainer ||
      !previewCharm ||
      !finishBtn ||
      !backTo1 ||
      !backTo2 ||
      !resetBtn
    )
      return;

    const stepDots = document.querySelectorAll(".step-dot");

    // ─── Render Charms ───
    charmsGrid.innerHTML = dijes
      .map(
        (dije, i) => `
      <button class="charm-card" data-index="${i}" style="animation-delay:${
          i * 60
        }ms">
        <div class="charm-img-wrap">
          <img src="${dije.url}" alt="${dije.name}" loading="lazy" />
        </div>
        <span class="charm-name">${dije.name}</span>
      </button>
    `
      )
      .join("");

    // ─── Step Navigation ───
    function goToStep(newStep: number) {
      // Map step number to array index (step 4 = result = index 3)
      const currentIdx = state.step <= 3 ? state.step - 1 : 3;
      const currentEl = stepEls[currentIdx];

      // Hide current panel
      if (currentEl) {
        currentEl.classList.remove("is-visible");
      }

      state.step = newStep;

      // Update progress fill (0%, 50%, 100%)
      const fillPercent = newStep <= 1 ? 0 : newStep === 2 ? 50 : 100;
      progressFill.style.width = `${fillPercent}%`;

      // Update step dots
      stepDots.forEach((dot, i) => {
        const dotCircle = dot.querySelector(".dot-circle");
        const dotSpan = dotCircle?.querySelector("span");
        if (!dotCircle || !dotSpan) return;

        dot.classList.remove("is-active", "is-done");

        if (i + 1 < state.step) {
          dot.classList.add("is-done");
          dotSpan.innerHTML =
            '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>';
        } else if (i + 1 === state.step) {
          dot.classList.add("is-active");
          dotSpan.textContent = `${i + 1}`;
        } else {
          dotSpan.textContent = `${i + 1}`;
        }
      });

      // Show new panel with a slight delay for the exit transition to finish
      const newIdx = newStep <= 3 ? newStep - 1 : 3;
      const newEl = stepEls[newIdx];
      setTimeout(() => {
        if (newEl) {
          newEl.classList.add("is-visible");
        }
      }, 220);
    }

    // ─── Step 1: Category Selection ───
    document.querySelectorAll(".cat-card").forEach((btn) => {
      btn.addEventListener("click", () => {
        const cat = (btn as HTMLElement).dataset.cat;
        if (!cat) return;

        state.category = cat;
        state.base = null;
        state.charm = null;

        // Reset preview
        resetPreview();

        // Populate bases for this category
        const bases = categoryBases[cat] || [];
        basesCarousel.innerHTML = bases
          .map(
            (url, i) => `
          <button class="base-card" data-url="${url}" style="animation-delay:${
              i * 70
            }ms">
            <img src="${url}" alt="Base ${i + 1}" loading="lazy" />
            <span class="base-label">Opción ${i + 1}</span>
            <div class="base-ring"></div>
          </button>
        `
          )
          .join("");

        // Attach base listeners
        basesCarousel.querySelectorAll(".base-card").forEach((baseEl) => {
          baseEl.addEventListener("click", () => {
            // Deselect all
            basesCarousel
              .querySelectorAll(".base-card")
              .forEach((el) => el.classList.remove("is-selected"));
            // Select this one
            baseEl.classList.add("is-selected");

            state.base = (baseEl as HTMLElement).dataset.url || null;

            // Update preview
            if (state.base) {
              emptyState.classList.add("is-hidden");
              previewBase.src = state.base;
              previewBase.classList.add("is-shown");
            }

            // Auto-advance to step 3
            setTimeout(() => goToStep(3), 500);
          });
        });

        goToStep(2);
      });
    });

    // ─── Step 2: Back ───
    backTo1.addEventListener("click", () => goToStep(1));

    // ─── Step 3: Back ───
    backTo2.addEventListener("click", () => {
      state.charm = null;
      charmsGrid
        .querySelectorAll(".charm-card")
        .forEach((el) => el.classList.remove("is-selected"));
      previewCharmContainer.classList.remove("is-shown");
      finishBtn.disabled = true;
      goToStep(2);
    });

    // ─── Step 3: Charm Selection ───
    charmsGrid.querySelectorAll(".charm-card").forEach((btn) => {
      btn.addEventListener("click", () => {
        const index = parseInt((btn as HTMLElement).dataset.index || "0", 10);
        const charm = dijes[index];
        if (!charm) return;

        // Deselect all charms
        charmsGrid
          .querySelectorAll(".charm-card")
          .forEach((el) => el.classList.remove("is-selected"));
        btn.classList.add("is-selected");

        state.charm = charm;

        // Position charm based on category
        const posMap: Record<string, string> = {
          collares:
            "bottom: 18%; left: 50%; transform: translateX(-50%); width: 56px; height: 56px;",
          pulseras:
            "top: 50%; left: 22%; transform: translateY(-50%); width: 44px; height: 44px;",
          anillos:
            "top: 32%; left: 50%; transform: translateX(-50%); width: 40px; height: 40px;",
          aretes:
            "bottom: 22%; left: 50%; transform: translateX(-50%); width: 48px; height: 48px;",
        };
        previewCharm.style.cssText =
          posMap[state.category || ""] || posMap.aretes;
        previewCharm.src = charm.url;
        previewCharmContainer.classList.add("is-shown");

        finishBtn.disabled = false;
      });
    });

    // ─── Finish ───
    finishBtn.addEventListener("click", () => goToStep(4));

    // ─── Reset ───
    resetBtn.addEventListener("click", () => {
      state = { step: 1, category: null, base: null, charm: null };
      resetPreview();
      charmsGrid
        .querySelectorAll(".charm-card")
        .forEach((el) => el.classList.remove("is-selected"));
      finishBtn.disabled = true;
      goToStep(1);
    });

    // ─── Helpers ───
    function resetPreview() {
      previewBase.classList.remove("is-shown");
      previewCharmContainer.classList.remove("is-shown");
      emptyState.classList.remove("is-hidden");
    }
  });
</script>

<style>
  /* ═══════════════════════════════════════════════
     Design Tokens (component-scoped)
     ═══════════════════════════════════════════════ */
  .custom-page {
    --ease-out: cubic-bezier(0.23, 1, 0.32, 1);
    --ease-in-out: cubic-bezier(0.77, 0, 0.175, 1);
    --dur-fast: 160ms;
    --dur-normal: 250ms;
    --dur-slow: 400ms;

    background: var(--brand-ivory);
    min-height: 100vh;
    font-family: "Outfit", sans-serif;
    padding-top: 120px;
    padding-bottom: 80px;
  }

  /* ═══════════════════════════════════════════════
     Page Header
     ═══════════════════════════════════════════════ */
  .custom-header {
    text-align: center;
    max-width: 580px;
    margin: 0 auto 56px;
    padding: 0 24px;
  }

  .header-star {
    color: var(--brand-gold);
    margin-bottom: 12px;
    display: flex;
    justify-content: center;
  }

  .header-overline {
    display: block;
    font-size: 11px;
    letter-spacing: 3.5px;
    color: var(--brand-vermillion);
    font-weight: 600;
    margin-bottom: 12px;
  }

  .header-title {
    font-family: "Cormorant Garamond", serif;
    font-size: clamp(2.2rem, 5vw, 3.4rem);
    color: var(--brand-wine);
    line-height: 1.15;
    margin-bottom: 14px;
  }

  .header-title em {
    font-style: italic;
    color: var(--brand-vermillion);
  }

  .header-desc {
    font-size: 1.05rem;
    color: #8c7a6b;
    line-height: 1.6;
    max-width: 440px;
    margin: 0 auto;
  }

  /* ═══════════════════════════════════════════════
     Customizer Layout
     ═══════════════════════════════════════════════ */
  .customizer-section {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .customizer {
    display: grid;
    grid-template-columns: 1fr 1fr;
    background: #ffffff;
    border-radius: 28px;
    overflow: hidden;
    box-shadow: 0 30px 80px -16px rgba(92, 26, 42, 0.08),
      0 8px 24px -8px rgba(0, 0, 0, 0.03);
    border: 1px solid rgba(232, 75, 16, 0.06);
  }

  /* ─── Controls Panel ─── */
  .customizer__controls {
    padding: 44px 48px;
    background: linear-gradient(145deg, #fdfbf7 0%, #f7f2ea 100%);
    display: flex;
    flex-direction: column;
    border-right: 1px solid rgba(232, 75, 16, 0.06);
  }

  /* ─── Preview Panel ─── */
  .customizer__preview {
    padding: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(155deg, #ffffff 0%, #fdf5ec 50%, #f7e7e0 100%);
    position: relative;
  }

  /* ═══════════════════════════════════════════════
     Progress Track
     ═══════════════════════════════════════════════ */
  .progress-track {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    position: relative;
    margin-bottom: 40px;
    padding: 0 8px;
  }

  .progress-line {
    position: absolute;
    top: 18px;
    left: 36px;
    right: 36px;
    height: 2px;
    background: #e8dccb;
    border-radius: 2px;
    z-index: 0;
  }

  .progress-fill {
    height: 100%;
    width: 0%;
    background: var(--brand-vermillion);
    border-radius: 2px;
    transition: width var(--dur-slow) var(--ease-out);
  }

  .step-dot {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    position: relative;
    z-index: 1;
  }

  .dot-circle {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: #e8dccb;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all var(--dur-normal) var(--ease-out);
  }

  .dot-circle span {
    font-size: 13px;
    font-weight: 700;
    color: #8c7a6b;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color var(--dur-normal) var(--ease-out);
  }

  .dot-label {
    font-size: 10px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: #8c7a6b;
    transition: color var(--dur-normal) var(--ease-out);
  }

  /* Active dot */
  .step-dot.is-active .dot-circle {
    background: var(--brand-vermillion);
    box-shadow: 0 4px 16px rgba(232, 75, 16, 0.3);
    transform: scale(1.1);
  }

  .step-dot.is-active .dot-circle span {
    color: #ffffff;
  }

  .step-dot.is-active .dot-label {
    color: var(--brand-vermillion);
  }

  /* Done dot */
