<section class="categories-section">
  <div class="container">
    <header class="section-header">
      <div class="top-decoration">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M12 2L13.5 10.5L22 12L13.5 13.5L12 22L10.5 13.5L2 12L10.5 10.5L12 2Z" fill="#F5C020"/></svg>
      </div>
      <span class="subtitle">NUESTRAS CATEGORÍAS</span>
      <h2 class="main-title">Encuentra tu esencia de <span class="italic-brand font-light text-neutral-900">verano</span></h2>
      <p class="section-desc">
        Explora nuestras categorías y descubre piezas hechas para brillar contigo.
      </p>
    </header>

    <div class="categories-grid">
      {categories.map((category, index) => (
        <a href={`/catalog/${category.id}`} class="category-card">
          <div class="image-wrapper">
            <Image src={category.image} alt={category.title} class="category-image" loading={index < 2 ? "eager" : "lazy"} />
          </div>
          
          <div class="card-body">
            <div class="floating-icon-container">
              <div class="floating-icon" set:html={category.icon} />
            </div>
            <h3 class="category-name">{category.title}</h3>
            <p class="category-info">{category.description}</p>
            <div class="card-footer">
              <span class="arrow-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 12h14M13 18l6-6-6-6"/></svg>
              </span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .categories-section {
    padding: 100px 20px;
    background-color: var(--brand-ivory);
    font-family: 'Outfit', sans-serif;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .section-header {
    text-align: center;
    margin-bottom: 50px;
  }

  .top-decoration { 
    display: flex;
    justify-content: center;
    margin-bottom: 10px; 
  }

  .top-decoration :global(svg) {
    fill: var(--brand-gold) !important;
  }

  .subtitle {
    display: block;
    font-size: 12px;
    letter-spacing: 3px;
    color: var(--brand-vermillion) !important;
    margin-bottom: 10px;
    font-weight: 600;
  }

  .main-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 3rem;
    margin-bottom: 15px;
  }

  .italic-brand { 
    font-style: italic; 
    color: var(--brand-vermillion) !important; 
  }

  .section-desc {
    color: #8C8C8C;
    font-size: 1.1rem;
    max-width: 500px;
    margin: 0 auto;
    line-height: 1.6;
  }

  /* Grid Styles */
  .categories-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 25px;
    margin-bottom: 60px;
  }

  .category-card {
    background: #FFFFFF;
    border-radius: 24px;
    border: 1px solid rgba(232, 75, 16, 0.12);
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
    position: relative;
    box-shadow: 0 15px 35px -10px rgba(0, 0, 0, 0.05);
  }

  .category-card:hover { 
    transform: translateY(-12px); 
    box-shadow: 0 30px 60px -12px rgba(232, 75, 16, 0.18);
    border-color: rgba(232, 75, 16, 0.3);
  }

  .image-wrapper {
    height: 300px;
    overflow: hidden;
    border-radius: 24px 24px 0 0;
  }

  .category-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .category-card:hover .category-image {
    transform: scale(1.05);
  }

  .card-body {
    padding: 40px 20px 30px;
    text-align: center;
    position: relative;
  }

  .floating-icon-container {
    position: absolute;
    top: -30px;
    left: 50%;
    transform: translateX(-50%);
    width: 60px;
    height: 60px;
  }

  .floating-icon {
    background: white;
    width: 60px;
    height: 60px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--brand-gold) !important;
    box-shadow: 
      0 10px 25px rgba(0, 0, 0, 0.08), 
      0 4px 10px rgba(0, 0, 0, 0.04);
  }

  .floating-icon :global(svg) {
    width: 28px !important;
    height: 28px !important;
    stroke: currentColor !important;
    filter: drop-shadow(0 2px 3px rgba(0, 0, 0, 0.1));
  }

  .category-name {
    font-size: 16px;
    letter-spacing: 2px;
    font-weight: 600;
    margin-bottom: 10px;
    color: var(--brand-wine);
  }

  .category-info {
    font-size: 13px;
    color: #8C8C8C;
    margin-bottom: 20px;
    line-height: 1.5;
  }

  .arrow-icon { 
    color: var(--brand-gold) !important; 
    transition: transform 0.3s ease;
  }

  .category-card:hover .arrow-icon {
    transform: translateX(5px);
  }

  .arrow-icon :global(svg) {
    stroke: currentColor !important;
  }

  @media (max-width: 768px) {
    .main-title { font-size: 2.2rem; }
    .categories-grid { grid-template-columns: repeat(2, 1fr); }
  }
  
  @media (max-width: 480px) {
    .categories-grid { grid-template-columns: 1fr; }
  }
</style>
