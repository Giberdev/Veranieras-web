---
import { Image } from 'astro:assets';
import heroImage from '../assets/hero.png';
import Button from './ui/Button.astro';
---

<section class="hero min-h-screen relative overflow-hidden flex items-center justify-start px-6 md:px-20">
  <Image 
    src={heroImage} 
    alt="Fondo Veranieras" 
    class="absolute inset-0 w-full h-full object-cover z-0"
    loading="eager"
  />
  
  <div class="absolute inset-0 bg-linear-to-r from-black/10 to-transparent z-10"></div>

  <div class="relative z-20 max-w-2xl text-left pt-20">
    <!-- Etiqueta superior -->
    <div class="flex items-center gap-4 mb-6">
      <span class="text-[10px] uppercase tracking-[0.3em] font-semibold text-neutral-800 font-sans">Nueva Colección</span>
      <div class="h-px w-12 bg-neutral-800/40"></div>
    </div>

    <!-- Título con Tipografía Serif -->
    <h1 class="text-5xl md:text-8xl leading-[0.9] font-serif text-neutral-900 mb-8">
      Accesorios que <br/> se sienten como <br/>
      <span class="italic-brand font-light text-brand-vermillion">verano</span>
    </h1>

    <div class="h-px w-48 bg-brand-gold/70 mb-8"></div>

    <p class="text-lg md:text-xl text-neutral-700 max-w-md mb-10 font-sans font-light leading-relaxed">
      Piezas hechas a mano para elevar tu outfit, contar tu historia y llevar un pedacito de sol contigo.
    </p>

    <!-- Botón Estilo Vino de Lujo (Reutilizable - Balancea el Naranja) -->
    <Button href="/catalog" variant="secondary" size="lg" className="group flex items-center gap-4">
      Ver Colección
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transition-transform group-hover:translate-x-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
      </svg>
    </Button>
  </div>

  <!-- Fila de beneficios inferior Centrada -->
  <div class="absolute bottom-12 left-6 md:left-20 right-6 md:right-20 hidden md:flex justify-start gap-16 border-neutral-300/50 z-20">
    
    <!-- Inspiradas en el Mar -->
    <div class="flex flex-col items-center text-center gap-3">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--brand-gold)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M2 6c.6.5 1.2 1 2.5 1C7 7 7 5 9.5 5c2.6 0 2.4 2 5 2 2.5 0 2.5-2 5-2 1.3 0 1.9.5 2.5 1"/>
        <path d="M2 12c.6.5 1.2 1 2.5 1 2.5 0 2.5-2 5-2 2.6 0 2.4 2 5 2 2.5 0 2.5-2 5-2 1.3 0 1.9.5 2.5 1"/>
        <path d="M2 18c.6.5 1.2 1 2.5 1 2.5 0 2.5-2 5-2 2.6 0 2.4 2 5 2 2.5 0 2.5-2 5-2 1.3 0 1.9.5 2.5 1"/>
      </svg>
      <span class="text-[9px] uppercase tracking-widest font-bold text-neutral-800">Inspiradas en el Mar</span>
    </div>

    <!-- Hechas a Mano -->
    <div class="flex flex-col items-center text-center gap-3">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--brand-gold)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M18 11V6a2 2 0 0 0-2-2v0a2 2 0 0 0-2 2v0"/>
        <path d="M14 10V4a2 2 0 0 0-2-2v0a2 2 0 0 0-2 2v0"/>
        <path d="M10 10.5V6a2 2 0 0 0-2-2v0a2 2 0 0 0-2 2v0"/>
        <path d="M18 8a2 2 0 1 1 4 0v6a8 8 0 0 1-8 8h-2c-2.8 0-4.5-.86-5.99-2.34l-3.6-3.6a2 2 0 0 1 2.83-2.82L7 15"/>
      </svg>
      <span class="text-[9px] uppercase tracking-widest font-bold text-neutral-800">Hechas a Mano</span>
    </div>

    <!-- Materiales de Calidad -->
    <div class="flex flex-col items-center text-center gap-3">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--brand-gold)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M6 3h12l4 6-10 12L2 9z"/>
        <path d="M11 3 8 9l4 12 4-12-3-6"/>
        <path d="M2 9h20"/>
      </svg>
      <span class="text-[9px] uppercase tracking-widest font-bold text-neutral-800">Materiales de Calidad</span>
    </div>

  </div>
</section>

<style>
  h1 {
    font-family: 'Cormorant Garamond', serif;
  }
  span, p, button {
    font-family: 'Outfit', sans-serif;
  }
</style>