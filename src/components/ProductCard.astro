---
// src/components/ProductCard.astro
import { Image } from 'astro:assets';

interface Props {
  product: {
    id: string;
    name: string;
    price: number;
    category: string;
    image: any; // We'll handle both string paths and imports
    description: string;
    isNew?: boolean;
  };
}

const { product } = Astro.props;

// For now, if it's a string starting with /src/assets, we might need to handle it 
// but since we're using static data, we'll try to use the image prop directly if passed as import.
// For this demo, let's assume images are passed correctly.
---

<div class="product-card">
  <div class="image-container">
    {product.isNew && <span class="badge">NUEVO</span>}
    <Image src={product.image} alt={product.name} class="product-image" />
    <div class="overlay">
      <button class="view-btn">VER DETALLE</button>
    </div>
  </div>
  
  <div class="product-info">
    <span class="category-tag">{product.category}</span>
    <h3 class="product-name">{product.name}</h3>
    <p class="product-price">${product.price.toFixed(2)}</p>
  </div>
</div>

<style>
  .product-card {
    background: white;
    border-radius: 20px;
    overflow: hidden;
    transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
    position: relative;
    border: 1px solid rgba(0,0,0,0.03);
  }

  .product-card:hover {
    transform: translateY(-10px);
    box-shadow: 0 20px 40px rgba(0,0,0,0.08);
  }

  .image-container {
    position: relative;
    aspect-ratio: 1/1;
    overflow: hidden;
    background: #F9F9F9;
  }

  .product-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .product-card:hover .product-image {
    transform: scale(1.1);
  }

  .badge {
    position: absolute;
    top: 15px;
    left: 15px;
    background: #F5C020;
    color: white;
    padding: 4px 12px;
    border-radius: 20px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1px;
    z-index: 2;
  }

  .overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0,0,0,0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .product-card:hover .overlay {
    opacity: 1;
  }

  .view-btn {
    background: white;
    color: #2D2D2D;
    border: none;
    padding: 12px 24px;
    border-radius: 30px;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    transform: translateY(20px);
    transition: all 0.3s ease;
  }

  .product-card:hover .view-btn {
    transform: translateY(0);
  }

  .product-info {
    padding: 20px;
    text-align: center;
  }

  .category-tag {
    font-size: 10px;
    text-transform: uppercase;
    color: #F5C020;
    letter-spacing: 2px;
    font-weight: 600;
    margin-bottom: 8px;
    display: block;
  }

  .product-name {
    font-family: 'Playfair Display', serif;
    font-size: 1.1rem;
    color: #2D2D2D;
    margin: 5px 0 10px;
  }

  .product-price {
    font-family: 'Outfit', sans-serif;
    font-weight: 600;
    color: #555;
    font-size: 1rem;
  }
</style>
