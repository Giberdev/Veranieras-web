---
// src/components/ProductCard.astro
import { Image } from 'astro:assets';

interface Props {
  product: {
    id: string;
    name: string;
    price: number;
    category: string;
    image: any;
    description: string;
    isNew?: boolean;
  };
  slug?: string;
  eager?: boolean;
}

const { product, slug, eager = false } = Astro.props;

const productUrl = slug ? `/catalog/producto/${slug}` : '#';
---

<a href={productUrl} class="product-card" transition:name={`image-container-${slug || product.id}`}>
  <div class="image-container">
    {product.isNew && <span class="badge">NUEVO</span>}
    <Image src={product.image} alt={product.name} class="product-image" loading={eager ? "eager" : "lazy"} />
    <div class="overlay">
      <span class="view-btn">VER DETALLE</span>
    </div>
  </div>
  
  <div class="product-info">
    <span class="category-tag">{product.category}</span>
    <h3 class="product-name">{product.name}</h3>
    <p class="product-price">${product.price.toFixed(2)}</p>
  </div>
</a>

<style>
  .product-card {
    display: block;
    text-decoration: none;
    background: white;
    border-radius: 24px; /* Unificado con Categories.astro */
    overflow: hidden;
    transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
    position: relative;
    border: 1px solid rgba(232, 75, 16, 0.12); /* Borde sutil naranja de Categories.astro */
    box-shadow: 0 15px 35px -10px rgba(0, 0, 0, 0.05); /* Sombra unificada */
  }

  .product-card:hover {
    transform: translateY(-10px);
    box-shadow: 0 20px 40px rgba(92, 26, 42, 0.08);
    border-color: rgba(232, 75, 16, 0.45); /* Hover activo unificado */
  }

  .image-container {
    position: relative;
    aspect-ratio: 1/1;
    overflow: hidden;
    background: #FDFBF7;
  }

  .product-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s cubic-bezier(0.165, 0.84, 0.44, 1);
  }

  .product-card:hover .product-image {
    transform: scale(1.08);
  }

  .badge {
    position: absolute;
    top: 15px;
    left: 15px;
    background: var(--brand-vermillion);
    color: white;
    padding: 4px 12px;
    border-radius: 20px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1px;
    z-index: 2;
  }

  .overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(92, 26, 42, 0.15); /* Tinted background for luxury feel */
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .product-card:hover .overlay {
    opacity: 1;
  }

  .view-btn {
    background: white;
    color: var(--brand-wine);
    border: none;
    padding: 12px 24px;
    border-radius: 30px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1px;
    transform: translateY(20px);
    transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
    box-shadow: 0 10px 20px rgba(0,0,0,0.1);
  }

  .product-card:hover .view-btn {
    transform: translateY(0);
  }

  .product-info {
    padding: 20px;
    text-align: center;
    background: white;
  }

  .category-tag {
    font-size: 10px;
    text-transform: uppercase;
    color: var(--brand-gold);
    letter-spacing: 2px;
    font-weight: 600;
    margin-bottom: 8px;
    display: block;
  }

  .product-name {
    font-family: 'Cormorant Garamond', serif; 
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--brand-wine);
    margin: 5px 0 10px;
    transition: color 0.3s ease;
  }

  .product-card:hover .product-name {
    color: var(--brand-vermillion);
  }

  .product-price {
    font-family: 'Outfit', sans-serif;
    font-weight: 600;
    color: #6E5A4F;
    font-size: 1rem;
  }
</style>
